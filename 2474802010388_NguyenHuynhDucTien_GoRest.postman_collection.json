      "name": "Positive_TCs",
      "item": [
        {
          "name": "POST User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "pm.test(\"POST User - Status 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "    });\r",
                  "\r",
                  "    if (pm.response.code === 201) {\r",
                  "        const user = pm.response.json();\r",
                  "\r",
                  "            pm.test(\"Response có User ID\", function () {\r",
                  "                    pm.expect(user.id).to.exist;\r",
                  "                        });\r",
                  "\r",
                  "                            pm.environment.set(\"user_id\", String(user.id));\r",
                  "                                pm.environment.set(\"created_email\", user.email);\r",
                  "                                }\r",
                  "                                "
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
